<ci:SettingsPageBase
    x:Class="ClassFabric.RemoteBroadcast.UI.RemoteBroadcastSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ci="http://classfabric.tech/schemas/xaml/core"
    xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <ci:IconText Glyph="{ci:FI ServerRegular}" Text="服务" Margin="0 0 0 4" />

            <!-- 服务开关 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI ServerRegular}}"
                                         Header="启用 HTTP 服务"
                                         Description="启用后本机在局域网监听端口，教师手机扫码即可打开呼叫页面；关闭后手机端一律无法访问。"
                                         IsExpanded="True">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch x:Name="ServiceToggle" OnContent="已启用" OffContent="已停用" />
                </controls:FASettingsExpander.Footer>

                <controls:FASettingsExpanderItem Content="监听端口"
                                                 Description="1024–65535。改完要点下面的「应用并重启服务」才会重新监听。">
                    <controls:FASettingsExpanderItem.Footer>
                        <ci:Field Suffix="端口">
                            <controls:FANumberBox x:Name="PortBox"
                                                  Minimum="1024" Maximum="65535"
                                                  SmallChange="1"
                                                  MinWidth="147"
                                                  SpinButtonPlacementMode="Inline" />
                        </ci:Field>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem.Footer>
                        <Button HorizontalAlignment="Left" Click="ApplyService_Click">
                            <ci:IconText Glyph="{ci:FI ArrowSyncRegular}" Text="应用并重启服务" />
                        </Button>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="二维码使用地址"
                                                 Description="多网卡（有线、无线、虚拟网卡）时，请选教师手机实际能访问的那个地址。">
                    <controls:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="AddressBox" MinWidth="260" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <!-- 4.4 一键授权条：仅当缺 urlacl 授权时出现，常态零文案 -->
                        <Border x:Name="UrlAclBar" IsVisible="False"
                                Background="#FFF4CE" BorderBrush="#E9A700" BorderThickness="1" CornerRadius="4"
                                Padding="10 8">
                            <StackPanel Spacing="8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="端口尚未授权局域网访问，手机暂时连不上。点击「一键授权」由系统代为执行（需要管理员确认）。" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="UrlAclButton" Click="UrlAcl_Click">
                                        <ci:IconText Glyph="{ci:FI ShieldRegular}" Text="一键授权" />
                                    </Button>
                                    <Button Click="CopyUrlAcl_Click">
                                        <ci:IconText Glyph="{ci:FI CopyRegular}" Text="复制命令" />
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="UrlAclMsgText" Classes="l-instructive" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 服务状态规格行卡（变体二·Win11「关于」风）：状态/地址/内核版本三行 -->
                        <Border Classes="status-spec" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                CornerRadius="6" Padding="0">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="12 8">
                                    <TextBlock Grid.Column="0" Text="内核状态" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="24 0 0 0" HorizontalAlignment="Left">
                                        <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center" Fill="Gray" />
                                        <TextBlock x:Name="StatusValueText" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" x:Name="StatusModeText" Classes="l-instructive" />
                                </Grid>
                                <Separator Margin="12 0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="12 8">
                                    <TextBlock Grid.Column="0" Text="访问地址" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" x:Name="AddressValueText" Margin="24 0 0 0"
                                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="点击复制访问地址" PointerReleased="CopyAddress_Click" />
                                    <TextBlock Grid.Column="2" x:Name="AddressCopyText" Classes="l-instructive" Text="复制" />
                                </Grid>
                                <Separator Margin="12 0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="12 8">
                                    <TextBlock Grid.Column="0" Text="内核版本" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" x:Name="KernelVersionText" Margin="24 0 0 0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" x:Name="KernelHostText" Classes="l-instructive" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <ci:IconText Glyph="{ci:FI MegaphoneRegular}" Text="播报" Margin="0 0 0 4" />

            <!-- 播报参数 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI MegaphoneRegular}}"
                                         Header="播报参数"
                                         Description="循环次数、语音提示、音量与音色。这几项和「模板」一起，由「保存播报设置」统一入库。"
                                         IsExpanded="True">
                <controls:FASettingsExpanderItem Content="循环次数"
                                                 Description="整段播报重复朗读的次数。人多时调低一些，免得播报拖得太长。">
                    <controls:FASettingsExpanderItem.Footer>
                        <ci:Field Suffix="次">
                            <controls:FANumberBox x:Name="LoopBox"
                                                  Minimum="1" Maximum="5"
                                                  SmallChange="1"
                                                  MinWidth="147"
                                                  SpinButtonPlacementMode="Inline" />
                        </ci:Field>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="语音播报"
                                                 Description="总开关：关闭后播报降级为纯视觉显示，不再进行任何语音合成（大屏无声）。">
                    <controls:FASettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="SpeechToggle" OnContent="开" OffContent="关" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="播报前语音提示"
                                                 Description="先念一句「{Caller}正在呼叫。」再念正文，提醒没盯着屏幕的老师。关闭语音播报时此项无效。">
                    <controls:FASettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="HintToggle" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="音量"
                                                 Description="0–100，按 5 步进。">
                    <controls:FASettingsExpanderItem.Footer>
                        <ci:Field Suffix="%">
                            <controls:FANumberBox x:Name="VolumeBox"
                                                  Minimum="0" Maximum="100"
                                                  SmallChange="5"
                                                  MinWidth="147"
                                                  SpinButtonPlacementMode="Inline" />
                        </ci:Field>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="EdgeTTS 音色"
                                                 Description="EdgeTTS 的语音名称，例如 zh-CN-XiaoxiaoNeural（晓晓）、zh-CN-YunxiNeural（云希）。">
                    <controls:FASettingsExpanderItem.Footer>
                        <TextBox x:Name="VoiceBox" Width="280" PlaceholderText="zh-CN-XiaoxiaoNeural" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="提醒音效"
                                                 Description="播报前的提示音在宿主提醒设置里配置：设置 → 提醒 → 远程广播（支持官方默认音与自定义音频）。">
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="播报条宽度"
                                                 Description="开启后按固定像素宽度显示播报条（改动即生效，无需保存）；关闭时跟随播报前岛条宽度（不低于屏幕宽度的 20%）。注意：播报条实际宽度 = 设置宽度与主线组件占位宽度的较大者——组件更宽时以组件为准。">
                    <controls:FASettingsExpanderItem.Footer>
                        <DockPanel>
                            <ToggleSwitch x:Name="CustomWidthToggle" DockPanel.Dock="Right"
                                          Margin="8 -8 0 0" VerticalAlignment="Center" />
                            <ci:Field Suffix="px" VerticalAlignment="Center">
                                <controls:FANumberBox x:Name="CustomWidthBox"
                                                      Minimum="200" Maximum="4000"
                                                      SmallChange="10"
                                                      MinWidth="147"
                                                      SpinButtonPlacementMode="Inline"
                                                      IsEnabled="False" />
                            </ci:Field>
                        </DockPanel>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <ci:IconText Glyph="{ci:FI TextFontRegular}" Text="模板" Margin="0 0 0 4" />

            <!-- 播报模板 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI TextFontRegular}}"
                                         Header="播报模板"
                                         Description="占位符支持 {Students} / {Destination} / {Caller} / {Contact}。{Caller} 是发起人（遮罩报「谁在呼叫」），{Contact} 是接洽人（正文「找谁」）；网页端选「不指定」时自动改用下方无接洽人模板。出现其它占位符将无法保存。"
                                         IsExpanded="True">
                <controls:FASettingsExpanderItem Content="单学生模板"
                                                 Description="只有一名学生时用这个模板。">
                    <controls:FASettingsExpanderItem.Footer>
                        <TextBox x:Name="TemplateSingleBox" Width="440" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="多学生引导句"
                                                 Description="多名学生时先念这句引导句，后面再接名单。">
                    <controls:FASettingsExpanderItem.Footer>
                        <TextBox x:Name="TemplateGuideBox" Width="440" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="语音提示模板"
                                                 Description="只有开启「播报前语音提示」时才会用到。">
                    <controls:FASettingsExpanderItem.Footer>
                        <TextBox x:Name="TemplateHintBox" Width="440" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="无接洽人模板（网页端选「不指定」时用）"
                                                 Description="上：单学生模板；下：多学生引导句。这对模板不应含 {Contact}——选「不指定」时播报自然不带「找某人」。">
                    <controls:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="6">
                            <TextBox x:Name="TemplateSingleNoContactBox" Width="440" />
                            <TextBox x:Name="TemplateMultiGuideNoContactBox" Width="440" />
                        </StackPanel>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="SaveAnnounceSettings_Click">
                                <ci:IconText Glyph="{ci:FI SaveRegular}" Text="保存播报设置" />
                            </Button>
                            <TextBlock x:Name="AnnounceMsgText" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
